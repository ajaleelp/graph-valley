# Copy this file to .env and fill in one key. .env is gitignored.
# npm start and npm run check load it automatically — nothing to install.

OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# The model matters a great deal here. gpt-4o-mini passes 1 topic in 5: it
# returns four atoms against a prompt asking for six to sixteen, and the retry
# does not reliably rescue it. gpt-4o passes 4 in 5.
OPENAI_MODEL=gpt-4o
# ANTHROPIC_MODEL=claude-sonnet-4-5
